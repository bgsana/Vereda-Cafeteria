<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Vereda Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/admin" class="logo">
                <span class="logo-icon">☕</span>
                <span class="logo-text">Vereda</span>
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <span class="nav-section-title">Geral</span>
                <a href="/admin"
                   class="nav-link @(Context.Request.Path.Value == "/admin" || Context.Request.Path.Value == "/admin/index" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/pedidos"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/pedidos") == true ? "active" : "")">
                    <i class="bi bi-receipt"></i>
                    <span>Pedidos</span>
                    <span class="badge-count">12</span>
                </a>
                <a href="/admin/produtos"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/produtos") == true ? "active" : "")">
                    <i class="bi bi-cup-hot"></i>
                    <span>Produtos</span>
                </a>
                <a href="/admin/clientes"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/clientes") == true ? "active" : "")">
                    <i class="bi bi-people"></i>
                    <span>Clientes</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">Conteúdo Site</span>
                <a href="/admin/sobrenos"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/sobrenos") == true ? "active" : "")">
                    <i class="bi bi-journal-text"></i>
                    <span>Sobre Nós</span>
                </a>
                <a asp-controller="NossoAmbiente" asp-action="Index"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/NossoAmbiente") == true ? "active" : "")">
                    <i class="bi bi-images"></i>
                    <span>Nosso Ambiente</span>
                </a>
                <a href="/admin/loja-vereda"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/loja-vereda") == true ? "active" : "")">
                    <i class="bi bi-bag-dash"></i>
                    <span>Loja Vereda</span>
                </a>
                <a href="/admin/loja-vereda"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/loja-vereda") == true ? "active" : "")">
                    <i class="bi bi-bag-dash"></i>
                    <span>Cardápio</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">Gestão</span>
                <a href="/admin/estoque"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/estoque") == true ? "active" : "")">
                    <i class="bi bi-box-seam"></i>
                    <span>Estoque</span>
                </a>
                <a href="/admin/cardapio"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/cardapio") == true ? "active" : "")">
                    <i class="bi bi-book"></i>
                    <span>Cardápio</span>
                </a>
                <a href="/admin/usuarios"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/usuarios") == true ? "active" : "")">
                    <i class="bi bi-person-badge"></i>
                    <span>Usuários</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">Financeiro</span>
                <a href="/admin/financeiro"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/financeiro") == true ? "active" : "")">
                    <i class="bi bi-cash-stack"></i>
                    <span>Financeiro</span>
                </a>
                <a href="/admin/relatorios"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/relatorios") == true ? "active" : "")">
                    <i class="bi bi-graph-up"></i>
                    <span>Relatórios</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">Sistema</span>
                <a href="/admin/configuracoes"
                   class="nav-link @(Context.Request.Path.Value?.StartsWith("/admin/configuracoes") == true ? "active" : "")">
                    <i class="bi bi-gear"></i>
                    <span>Configurações</span>
                </a>
                <form asp-controller="Conta" asp-action="Logout" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link logout-link"
                            style="background:none;border:none;width:100%;text-align:left;cursor:pointer;">
                        <i class="bi bi-box-arrow-left"></i>
                        <span>Sair</span>
                    </button>
                </form>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="version-tag">v2.0.1</div>
        </div>
    </aside>

    <main class="main-wrapper">
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle" id="menuToggle">
                    <i class="bi bi-list"></i>
                </button>

                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Buscar...">
                    <span class="search-shortcut">⌘K</span>
                </div>
            </div>

            <div class="topbar-right">
                <button class="icon-btn" type="button">
                    <i class="bi bi-bell"></i>
                    <span class="notification-dot"></span>
                </button>

                <button class="profile-btn" type="button">
                    <div class="profile-avatar"><span>VR</span></div>
                    <div class="profile-info">
                        <span class="profile-name">Vereda</span>
                        <span class="profile-role">Admin</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
        </header>

        <div class="content-wrapper">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>

</html>