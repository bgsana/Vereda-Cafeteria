@model Vereda_Cafeteria.ViewModels.DashboardVM
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "DashBoard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<div class="topbar">
    <div>
        <div class="page-eyebrow">visão geral · hoje</div>
        <div class="page-title">Bom dia, Vereda!</div>
    </div>
    <div class="topbar-right">
        <span class="date-badge">@DateTime.Now.ToString("dddd, d MMMM yyyy", new System.Globalization.CultureInfo("pt-BR"))</span>
        <button class="btn btn-ghost">↓ Exportar</button>
        <button class="btn btn-primary">+ Novo Pedido</button>
    </div>
</div>

@if (Model == null)
{
    <div class="alert alert-danger">Erro: O modelo de dados não foi carregado. Verifique o AdminController.</div>
    return;
}

<div class="kpi-grid">
    <div class="kpi-card k1">
        <div class="kpi-label">Faturamento hoje</div>
        <div class="kpi-value">R$@Model.FaturamentoHoje.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>
        <div class="kpi-change @(Model.PercentualFaturamentoVariacao >= 0 ? "up" : "down")">
            @(Model.PercentualFaturamentoVariacao >= 0 ? "↑" : "↓") @Math.Abs(Model.PercentualFaturamentoVariacao).ToString("N0")% vs ontem
        </div>
    </div>
    <div class="kpi-card k2">
        <div class="kpi-label">Pedidos</div>
        <div class="kpi-value">@Model.PedidosHoje</div>
        <div class="kpi-change @(Model.VariacaoPedidos >= 0 ? "up" : "down")">
            @(Model.VariacaoPedidos >= 0 ? "↑" : "↓") @Math.Abs(Model.VariacaoPedidos) @(Math.Abs(Model.VariacaoPedidos) == 1 ? "a mais" : "a mais")
        </div>
    </div>
    <div class="kpi-card k3">
        <div class="kpi-label">Ticket médio</div>
        <div class="kpi-value">R$@Model.TicketMedio.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>
        <div class="kpi-change @(Model.VariacaoTicketMedio >= 0 ? "up" : "down")">
            @(Model.VariacaoTicketMedio >= 0 ? "↑" : "↓") R$@Math.Abs(Model.VariacaoTicketMedio).ToString("N2")
        </div>
    </div>
    <div class="kpi-card k4">
        <div class="kpi-label">Item mais pedido</div>
        <div class="kpi-value">@(Model.ItemMaisPedido ?? "Nenhum")</div>
        <div class="kpi-change up">↑ @Model.QtdItemMaisPedido pedidos hoje</div>
    </div>
</div>

<div class="row2">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Faturamento da Semana</div>
            <span class="card-sub">últimos 7 dias</span>
        </div>
        <div class="chart-area">
            <svg class="chart-svg" id="lineChart" viewBox="0 0 600 150" preserveAspectRatio="none"></svg>
        </div>
        <div class="x-labels">
            @if (Model.FaturamentoSemana != null)
            {
                foreach (var item in Model.FaturamentoSemana)
                {
                    <span class="x-label">@item.Dia</span>
                }
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="card-title">Top Produtos</div>
            <span class="card-sub">Geral</span>
        </div>
        <div class="product-list">
            @if (Model.TopProdutos != null)
            {
                foreach (var produto in Model.TopProdutos)
                {
                    <div class="product-row">
                        <div class="product-info"><div class="product-name">@produto.Nome</div><div class="product-cat">@produto.Categoria</div></div>
                        <div class="product-bar-wrap">
                            <div class="product-bar-bg"><div class="product-bar-fill" style="width:@produto.Percentual%;background:var(--verde);animation-delay:.3s"></div></div>
                            <span class="product-val">@produto.Quantidade</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="row3">
    <div class="card" style="animation-delay:.42s">
        <div class="card-header"><div class="card-title">Pedidos Recentes</div></div>
        <table class="orders-table">
            <thead><tr><th>#</th><th>Cliente</th><th>Valor</th><th>Data</th></tr></thead>
            <tbody>
                @if (Model.PedidosRecentes != null)
                {
                    foreach (var pedido in Model.PedidosRecentes)
                    {
                        <tr>
                            <td style="color:var(--muted);font-size:12px">#@pedido.PedidoId</td>
                            <td>@pedido.NomeCliente</td>
                            <td>R$@pedido.ValorTotal.ToString("N2")</td>
                            <td>@pedido.DataPedido.ToString("dd/MM HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card" style="animation-delay:.54s">
        <div class="card-header"><div class="card-title">Metas</div></div>
        <div class="mini-stats">
            <div>
                <div class="mini-stat">
                    <div class="mini-stat-label"><div class="mini-stat-dot" style="background:var(--verde)"></div>Meta mensal</div>
                    <div class="mini-stat-val">@Model.MetaMensal%</div>
                </div>
                <div class="mini-progress"><div class="mini-fill" style="width:@Model.MetaMensal%;background:var(--verde);animation-delay:.5s"></div></div>
            </div>
            <div>
                <div class="mini-stat">
                    <div class="mini-stat-label"><div class="mini-stat-dot" style="background:var(--vinho)"></div>Satisfação</div>
                    <div class="mini-stat-val">@Model.Satisfacao%</div>
                </div>
                <div class="mini-progress"><div class="mini-fill" style="width:@Model.Satisfacao%;background:var(--vinho);animation-delay:.6s"></div></div>
            </div>
            <div>
                <div class="mini-stat">
                    <div class="mini-stat-label"><div class="mini-stat-dot" style="background:var(--terra)"></div>Estoque OK</div>
                    <div class="mini-stat-val">@Model.EstoqueOk%</div>
                </div>
                <div class="mini-progress"><div class="mini-fill" style="width:@Model.EstoqueOk%;background:var(--terra);animation-delay:.7s"></div></div>
            </div>
            <div>
                <div class="mini-stat">
                    <div class="mini-stat-label"><div class="mini-stat-dot" style="background:var(--agua)"></div>Fidelidade</div>
                    <div class="mini-stat-val">@Model.Fidelidade%</div>
                </div>
                <div class="mini-progress"><div class="mini-fill" style="width:@Model.Fidelidade%;background:var(--agua);animation-delay:.8s"></div></div>
            </div>
        </div>
    </div>
</div>

<script>
    // LINE CHART COM DADOS REAIS
    const vals = [@(Model.FaturamentoSemana != null ? string.Join(",", Model.FaturamentoSemana.Select(f => f.Valor.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))) : "0")];
    const svgEl = document.getElementById('lineChart');
    const W = 600, H = 150, pad = 20;
    const maxV = Math.max(...vals, 1);
    const pts = vals.map((v, i) => [pad + (i / (vals.length - 1)) * (W - pad * 2), H - pad - ((v / maxV) * (H - pad * 2))]);

    const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
    defs.innerHTML = `<linearGradient id="ag" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#00464B" stop-opacity=".22"/>
        <stop offset="100%" stop-color="#00464B" stop-opacity="0"/>
    </linearGradient>`;
    svgEl.appendChild(defs);

    [0, .5, 1].forEach(f => {
        const y = pad + (1 - f) * (H - pad * 2);
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        g.setAttribute('x1', pad); g.setAttribute('x2', W - pad);
        g.setAttribute('y1', y); g.setAttribute('y2', y);
        g.setAttribute('stroke', 'rgba(55,35,20,.07)'); g.setAttribute('stroke-width', '1');
        svgEl.appendChild(g);
    });

    const area = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    area.setAttribute('d', `M${pts[0][0]},${H - pad} ${pts.map(p => `L${p[0]},${p[1]}`).join(' ')} L${pts[pts.length - 1][0]},${H - pad} Z`);
    area.setAttribute('fill', 'url(#ag)');
    svgEl.appendChild(area);

    const line = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    line.setAttribute('d', `M${pts.map(p => `${p[0]},${p[1]}`).join(' L')}`);
    line.setAttribute('fill', 'none'); line.setAttribute('stroke', '#00464B');
    line.setAttribute('stroke-width', '2.5'); line.setAttribute('stroke-linejoin', 'round'); line.setAttribute('stroke-linecap', 'round');
    svgEl.appendChild(line);

    pts.forEach(([x, y], i) => {
        const isLast = i === pts.length - 1;
        const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        c.setAttribute('cx', x); c.setAttribute('cy', y); c.setAttribute('r', isLast ? 5 : 3.5);
        c.setAttribute('fill', isLast ? '#00464B' : '#FDFAF6');
        c.setAttribute('stroke', '#00464B'); c.setAttribute('stroke-width', '2');
        svgEl.appendChild(c);
        if (isLast) {
            const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            t.setAttribute('x', x); t.setAttribute('y', y - 11); t.setAttribute('text-anchor', 'middle');
            t.setAttribute('fill', '#372314'); t.setAttribute('font-size', '11');
            t.setAttribute('font-family', 'Karla,sans-serif'); t.setAttribute('font-weight', '600');
            t.textContent = `R$${vals[i].toLocaleString('pt-BR')}`;
            svgEl.appendChild(t);
        }
    });
</script>
