@model Vereda_Cafeteria.ViewModels.DashboardVM
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "DashBoard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<div class="topbar">
    <div>
        <div class="page-eyebrow">visão geral</div>
        <div class="page-title">Bom dia, Vereda!</div>
    </div>
    <div class="topbar-right">
        <span class="date-badge">@DateTime.Now.ToString("dddd, d MMMM yyyy", new System.Globalization.CultureInfo("pt-BR"))</span>
    </div>
</div>

@if (Model == null)
{
    <div class="alert alert-danger">Erro: O modelo de dados não foi carregado. Verifique o AdminController.</div>
    return;
}

<div class="kpi-grid">
    <div class="kpi-card k1">
        <div class="kpi-label">Faturamento hoje</div>
        <div class="kpi-value">R$@Model.FaturamentoHoje.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>
        <div class="kpi-change @(Model.PercentualFaturamentoVariacao >= 0 ? "up" : "down")">
            @(Model.PercentualFaturamentoVariacao >= 0 ? "↑" : "↓") @Math.Abs(Model.PercentualFaturamentoVariacao).ToString("N0")% vs ontem
        </div>
    </div>
    <div class="kpi-card k2">
        <div class="kpi-label">Pedidos confirmados</div>
        <div class="kpi-value">@Model.PedidosHoje</div>
        <div class="kpi-change @(Model.VariacaoPedidos >= 0 ? "up" : "down")">
            @(Model.VariacaoPedidos >= 0 ? "↑" : "↓") @Math.Abs(Model.VariacaoPedidos) vs ontem
        </div>
    </div>
    <div class="kpi-card k3">
        <div class="kpi-label">Ticket médio</div>
        <div class="kpi-value">R$@Model.TicketMedio.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>
        <div class="kpi-change @(Model.VariacaoTicketMedio >= 0 ? "up" : "down")">
            @(Model.VariacaoTicketMedio >= 0 ? "↑" : "↓") R$@Math.Abs(Model.VariacaoTicketMedio).ToString("N2")
        </div>
    </div>
    <div class="kpi-card k4">
        <div class="kpi-label">Item mais pedido</div>
        <div class="kpi-value">@(Model.ItemMaisPedido ?? "Nenhum")</div>
        <div class="kpi-change up">↑ @Model.QtdItemMaisPedido pedidos na semana</div>
    </div>
</div>

<div class="row2">
    <div class="card card-tall">
        <div class="card-header">
            <div class="card-title">Faturamento da Semana</div>
            <span class="card-sub">últimos 7 dias</span>
        </div>
        <div class="chart-area chart-area-tall">
            <svg class="chart-svg" id="lineChart" viewBox="0 0 600 200" preserveAspectRatio="none"></svg>
        </div>
        <div class="x-labels">
            @if (Model.FaturamentoSemana != null)
            {
                foreach (var item in Model.FaturamentoSemana)
                {
                    <span class="x-label">@item.Dia</span>
                }
            }
        </div>
    </div>

    <div class="card card-tall">
        <div class="card-header">
            <div class="card-title">Top Produtos</div>
            <span class="card-sub">esta semana</span>
        </div>
        <div class="product-list">
            @if (Model.TopProdutos != null && Model.TopProdutos.Any())
            {
                foreach (var produto in Model.TopProdutos)
                {
                    <div class="product-row">
                        <div class="product-info">
                            <div class="product-name">@produto.Nome</div>
                            <div class="product-cat">@produto.Categoria</div>
                        </div>
                        <div class="product-bar-wrap">
                            <div class="product-bar-bg">
                                <div class="product-bar-fill" style="width:@produto.Percentual%;background:var(--verde);animation-delay:.3s"></div>
                            </div>
                            <span class="product-val">@produto.Quantidade</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="color:var(--muted);font-size:0.85rem;text-align:center;padding:1rem 0;">Nenhum produto vendido na semana.</div>
            }
        </div>
    </div>
</div>

<div class="row3-full">
    <div class="card" style="animation-delay:.42s">
        <div class="card-header">
            <div class="card-title">Pedidos Confirmados</div>
            <span class="card-sub">recentes</span>
        </div>
        <table class="orders-table">
            <thead>
                <tr><th>#</th><th>Cliente</th><th>Telefone</th><th>Valor</th><th>Pagamento</th><th>Recebimento</th><th>Data</th></tr>
            </thead>
            <tbody>
                @if (Model.PedidosConfirmados != null)
                {
                    foreach (var pedido in Model.PedidosConfirmados)
                    {
                        <tr>
                            <td style="color:var(--muted);font-size:12px">#@pedido.PedidoId</td>
                            <td>@pedido.NomeCliente</td>
                            <td>@pedido.Telefone</td>
                            <td>R$@pedido.ValorTotal.ToString("N2")</td>
                            <td>@pedido.FormaPagamento</td>
                            <td>@pedido.FormaRecebimento</td>
                            <td>@pedido.DataPedido.ToString("dd/MM HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* Dados serializados para o PDF — tipo application/json evita execução pelo browser *@
<script id="dashboardData" type="application/json">
{
    "faturamentoHoje": "@Model.FaturamentoHoje.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))",
    "pedidosHoje": @Model.PedidosHoje,
    "ticketMedio": "@Model.TicketMedio.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))",
    "itemMaisPedido": "@Html.Raw(Model.ItemMaisPedido ?? "Nenhum")",
    "qtdItemMaisPedido": @Model.QtdItemMaisPedido,
    "variacaoFaturamento": @Model.PercentualFaturamentoVariacao.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
    "variacaoPedidos": @Model.VariacaoPedidos,
    "variacaoTicket": @Model.VariacaoTicketMedio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
    "semana": [@(Model.FaturamentoSemana != null ? string.Join(",", Model.FaturamentoSemana.Select(f => $"{{\"dia\":\"{f.Dia}\",\"valor\":{f.Valor.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}}}")) : "")],
    "topProdutos": [@(Model.TopProdutos != null ? string.Join(",", Model.TopProdutos.Select(p => $"{{\"nome\":\"{p.Nome.Replace("\"","\\\"")}\",\"categoria\":\"{p.Categoria.Replace("\"","\\\"")}\",\"quantidade\":{p.Quantidade},\"percentual\":{p.Percentual}}}")) : "")],
    "pedidosConfirmados": [@(Model.PedidosConfirmados != null ? string.Join(",", Model.PedidosConfirmados.Select(p => $"{{\"id\":{p.PedidoId},\"cliente\":\"{p.NomeCliente.Replace("\"","\\\"")}\",\"telefone\":\"{p.Telefone}\",\"valor\":{p.ValorTotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)},\"pagamento\":\"{p.FormaPagamento}\",\"recebimento\":\"{p.FormaRecebimento}\",\"data\":\"{p.DataPedido.ToString("dd/MM HH:mm")}\"}}")) : "")]
}
</script>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
// ── LINE CHART ──────────────────────────────────────────────────────────────
const vals = [@(Model.FaturamentoSemana != null
    ? string.Join(",", Model.FaturamentoSemana.Select(f => f.Valor.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)))
    : "0")];

const svgEl = document.getElementById('lineChart');
const W = 600, H = 200, pad = 20;
const maxV = Math.max(...vals, 1);
const pts  = vals.map((v, i) => [
    pad + (i / (vals.length - 1)) * (W - pad * 2),
    H - pad - ((v / maxV) * (H - pad * 2))
]);

// gradiente
const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
defs.innerHTML = `<linearGradient id="ag" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0%"   stop-color="#00464B" stop-opacity=".22"/>
    <stop offset="100%" stop-color="#00464B" stop-opacity="0"/>
</linearGradient>`;
svgEl.appendChild(defs);

// linhas de grade
[0, .5, 1].forEach(f => {
    const y = pad + (1 - f) * (H - pad * 2);
    const g = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    g.setAttribute('x1', pad); g.setAttribute('x2', W - pad);
    g.setAttribute('y1', y);  g.setAttribute('y2', y);
    g.setAttribute('stroke', 'rgba(55,35,20,.07)'); g.setAttribute('stroke-width', '1');
    svgEl.appendChild(g);
});

// área preenchida
const area = document.createElementNS('http://www.w3.org/2000/svg', 'path');
area.setAttribute('d', `M${pts[0][0]},${H-pad} ${pts.map(p=>`L${p[0]},${p[1]}`).join(' ')} L${pts[pts.length-1][0]},${H-pad} Z`);
area.setAttribute('fill', 'url(#ag)');
svgEl.appendChild(area);

// linha
const line = document.createElementNS('http://www.w3.org/2000/svg', 'path');
line.setAttribute('d', `M${pts.map(p=>`${p[0]},${p[1]}`).join(' L')}`);
line.setAttribute('fill', 'none'); line.setAttribute('stroke', '#00464B');
line.setAttribute('stroke-width', '2.5');
line.setAttribute('stroke-linejoin', 'round'); line.setAttribute('stroke-linecap', 'round');
svgEl.appendChild(line);

// pontos + labels
pts.forEach(([x, y], i) => {
    const isMax = vals[i] === Math.max(...vals) && vals[i] > 0;
    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('cx', x); c.setAttribute('cy', y);
    c.setAttribute('r', isMax ? 5 : 3.5);
    c.setAttribute('fill', isMax ? '#00464B' : '#FFFFFF');
    c.setAttribute('stroke', '#00464B'); c.setAttribute('stroke-width', '2');
    svgEl.appendChild(c);
    if (vals[i] > 0) {
        const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        t.setAttribute('x', x); t.setAttribute('y', y - 11);
        t.setAttribute('text-anchor', 'middle');
        t.setAttribute('fill', '#372314'); t.setAttribute('font-size', '10');
        t.setAttribute('font-family', 'Montserrat,sans-serif'); t.setAttribute('font-weight', '600');
        t.textContent = `R$${vals[i].toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
        svgEl.appendChild(t);
    }
});

</script>
}