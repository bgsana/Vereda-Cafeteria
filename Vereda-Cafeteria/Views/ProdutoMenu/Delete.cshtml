@model Vereda_Cafeteria.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-menu.css" />
}

<h1>Excluir Produto</h1>

<h4>Tem certeza que deseja excluir este produto?</h4>
<hr />

<div>
    <dl class="row">
        <dd class="col-sm-10">
            <img src="@Model.ImagemUrl" alt="@Model.Nome"
                 style="width:150px;height:150px;object-fit:cover;border-radius:6px;border:1px solid rgba(55,35,20,0.12);" />
        </dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nome)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Descricao)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Descricao)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.QtdEstoque)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.QtdEstoque)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Preco)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Preco)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ativo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Ativo)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Categoria)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Categoria!.Nome)</dd>
    </dl>


    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.ProdutoId" />

        <button type="submit" class="btn btn-danger">
            Excluir
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>
