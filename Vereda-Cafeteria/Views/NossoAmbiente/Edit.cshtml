@model Vereda_Cafeteria.Models.AmbienteImagem

@{
    ViewData["Title"] = "Editar Imagem";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Editar Imagem</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CaminhoImagem" />
            <div class="form-group">
                <label class="control-label">Imagem</label>
                @if (!string.IsNullOrEmpty(Model.CaminhoImagem))
                {
                    <div class="mb-2">
                        <img src="@Model.CaminhoImagem" alt="Imagem"
                             style="width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid rgba(55,35,20,0.12);" />
                        <small class="text-muted d-block">Imagem atual</small>
                    </div>
                }
                <input type="file" name="imagemArquivo" accept="image/*" class="form-control" />
                <small class="text-muted">Deixe em branco para manter a imagem atual</small>
            </div>
            <div class="form-group">
                <label asp-for="Ordem" class="control-label"></label>
                <input asp-for="Ordem" class="form-control" />
                <span asp-validation-for="Ordem" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Ativo" /> @Html.DisplayNameFor(model => model.Ativo)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
