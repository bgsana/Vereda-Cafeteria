@model Vereda_Cafeteria.Models.AmbienteImagem

@{
    ViewData["Title"] = "Excluir Imagem";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Excluir Imagem</h1>

<h4>Tem certeza que deseja excluir esta imagem?</h4>
<hr />

<div>
    <dl class="row">
        <dd class="col-sm-10">
            <img src="@Model.CaminhoImagem" alt="Imagem"
                 style="width:150px;height:150px;object-fit:cover;border-radius:6px;border:1px solid rgba(55,35,20,0.12);" />
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ordem)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ordem)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ativo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ativo)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
