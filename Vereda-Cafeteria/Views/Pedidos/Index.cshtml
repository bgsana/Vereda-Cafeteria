@model IEnumerable<Vereda_Cafeteria.Models.Pedido>
@using Models

@{
    ViewData["Title"] = "Pedidos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var pendentes    = Model.Where(p => p.Status == StatusPedido.Pendente).ToList();
    var confirmados  = Model.Where(p => p.Status == StatusPedido.Confirmado).ToList();
    var cancelados   = Model.Where(p => p.Status == StatusPedido.Cancelado).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-pedido.css" asp-append-version="true" />
}

<h1>Pedidos</h1>

<!-- ===================== PENDENTES ===================== -->
<div class="secao-pedidos">
    <div class="secao-header secao-pendente">
        <div class="secao-header-info">
            <i class="bi bi-clock-history"></i>
            <span>Pendentes</span>
            <span class="secao-count">@pendentes.Count</span>
        </div>
        <p class="secao-descricao">Pedidos aguardando confirmação da equipe.</p>
    </div>

    @if (!pendentes.Any())
    {
        <div class="secao-vazia">
            <i class="bi bi-inbox"></i>
            <span>Nenhum pedido pendente no momento.</span>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var pedido in pendentes)
            {
                <div class="order-card order-card-pendente" id="card-@pedido.PedidoId">
                    <div class="order-header">
                        <div>
                            <strong>@pedido.NomeCliente</strong>
                            <span class="text-muted">#@pedido.PedidoId · @pedido.Telefone</span>
                        </div>
                        <span class="status-badge status-pendente">Pendente</span>
                    </div>

                    <div class="order-items">
                        <ul>
                            @foreach (var item in pedido.ItensPedido)
                            {
                                <li>
                                    <span>@item.Quantidade× @(item.Produto?.Nome ?? "Produto")</span>
                                    <strong>R$ @item.SubTotal.ToString("N2")</strong>
                                </li>
                            }
                        </ul>
                        <div class="text-end">Total: R$ @pedido.ValorTotal.ToString("N2")</div>
                    </div>

                    <div class="order-footer">
                        <div>
                            <span class="footer-info-item">
                                <i class="bi bi-calendar3"></i>
                                @pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")
                            </span>
                            <span class="footer-separador">·</span>
                            <span class="footer-info-item">
                                <i class="bi bi-wallet2"></i>
                                @pedido.FormaPagamento
                            </span>
                            <span class="footer-separador">·</span>
                            <span class="footer-info-item">
                                <i class="bi bi-geo-alt"></i>
                                @pedido.FormaRecebimento
                            </span>
                        </div>
                        <div class="acoes-pedido">
                            <button class="btn-acao btn-confirmar" onclick="alterarStatus(@pedido.PedidoId, 'Confirmar')">
                                <i class="bi bi-check-circle"></i> Confirmar
                            </button>
                            <button class="btn-acao btn-cancelar" onclick="alterarStatus(@pedido.PedidoId, 'Cancelar')">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ===================== CONFIRMADOS ===================== -->
<div class="secao-pedidos">
    <div class="secao-header secao-confirmado">
        <div class="secao-header-info">
            <i class="bi bi-check-circle-fill"></i>
            <span>Confirmados</span>
            <span class="secao-count">@confirmados.Count</span>
        </div>
        <p class="secao-descricao">Pedidos confirmados e em preparo ou já entregues.</p>
    </div>

    @if (!confirmados.Any())
    {
        <div class="secao-vazia">
            <i class="bi bi-inbox"></i>
            <span>Nenhum pedido confirmado.</span>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var pedido in confirmados)
            {
                <div class="order-card order-card-confirmado" id="card-@pedido.PedidoId">
                    <div class="order-header">
                        <div>
                            <strong>@pedido.NomeCliente</strong>
                            <span class="text-muted">#@pedido.PedidoId · @pedido.Telefone</span>
                        </div>
                        <span class="status-badge status-confirmado">Confirmado</span>
                    </div>

                    <div class="order-items">
                        <ul>
                            @foreach (var item in pedido.ItensPedido)
                            {
                                <li>
                                    <span>@item.Quantidade× @(item.Produto?.Nome ?? "Produto")</span>
                                    <strong>R$ @item.SubTotal.ToString("N2")</strong>
                                </li>
                            }
                        </ul>
                        <div class="text-end">Total: R$ @pedido.ValorTotal.ToString("N2")</div>
                    </div>

                    <div class="order-footer">
                        <div>
                            <span class="footer-info-item">
                                <i class="bi bi-calendar3"></i>
                                @pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")
                            </span>
                            <span class="footer-separador">·</span>
                            <span class="footer-info-item">
                                <i class="bi bi-wallet2"></i>
                                @pedido.FormaPagamento
                            </span>
                            <span class="footer-separador">·</span>
                            <span class="footer-info-item">
                                <i class="bi bi-geo-alt"></i>
                                @pedido.FormaRecebimento
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ===================== CANCELADOS ===================== -->
<div class="secao-pedidos">
    <div class="secao-header secao-cancelado">
        <div class="secao-header-info">
            <i class="bi bi-x-circle-fill"></i>
            <span>Cancelados</span>
            <span class="secao-count">@cancelados.Count</span>
        </div>
        <p class="secao-descricao">Pedidos que foram cancelados.</p>
    </div>

    @if (!cancelados.Any())
    {
        <div class="secao-vazia">
            <i class="bi bi-inbox"></i>
            <span>Nenhum pedido cancelado.</span>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var pedido in cancelados)
            {
                <div class="order-card order-card-cancelado" id="card-@pedido.PedidoId">
                    <div class="order-header">
                        <div>
                            <strong>@pedido.NomeCliente</strong>
                            <span class="text-muted">#@pedido.PedidoId · @pedido.Telefone</span>
                        </div>
                        <span class="status-badge status-cancelado">Cancelado</span>
                    </div>

                    <div class="order-items">
                        <ul>
                            @foreach (var item in pedido.ItensPedido)
                            {
                                <li>
                                    <span>@item.Quantidade× @(item.Produto?.Nome ?? "Produto")</span>
                                    <strong>R$ @item.SubTotal.ToString("N2")</strong>
                                </li>
                            }
                        </ul>
                        <div class="text-end">Total: R$ @pedido.ValorTotal.ToString("N2")</div>
                    </div>

                    <div class="order-footer">
                        <div>
                            <span class="footer-info-item">
                                <i class="bi bi-calendar3"></i>
                                @pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")
                            </span>
                            <span class="footer-separador">·</span>
                            <span class="footer-info-item">
                                <i class="bi bi-wallet2"></i>
                                @pedido.FormaPagamento
                            </span>
                            <span class="footer-separador">·</span>
                            <span class="footer-info-item">
                                <i class="bi bi-geo-alt"></i>
                                @pedido.FormaRecebimento
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
async function alterarStatus(id, acao) {
    const url = `/Pedidos/${acao}/${id}`;
    try {
        const resp = await fetch(url, {
            method: 'POST',
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' }
        });
        if (resp.ok) {
            window.location.reload();
        } else {
            alert('Erro ao atualizar o pedido. Tente novamente.');
        }
    } catch (e) {
        alert('Erro de conexão.');
    }
}
</script>
@Html.AntiForgeryToken()
}
