@model IEnumerable<Vereda_Cafeteria.Models.Produto>

@{
    ViewData["Title"] = "Produtos do Ateliê";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var categorias = Model
        .Where(p => p.Categoria != null)
        .Select(p => p.Categoria!)
        .GroupBy(c => c.CategoriaId)
        .Select(g => g.First())
        .OrderBy(c => c.CategoriaId)
        .ToList();
}

<h1>Produtos do Ateliê</h1>

<div class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary">Adicionar</a>

    <div class="category-filter" id="categoryFilter">
        <button type="button" class="category-filter-toggle" id="categoryFilterToggle">
            <i class="bi bi-funnel"></i>
            <span class="category-filter-label">Selecione os assuntos</span>
            <i class="bi bi-chevron-down category-filter-arrow"></i>
        </button>
        <div class="category-filter-menu">
            <div class="category-filter-list">
                @foreach (var categoria in categorias)
                {
                    <label class="category-filter-item">
                        <input type="checkbox" class="category-filter-checkbox" value="@categoria.CategoriaId" />
                        <span>@categoria.Nome</span>
                    </label>
                }
            </div>
            <div class="category-filter-footer">
                <button type="button" class="category-filter-clear">Mostrar todos</button>
            </div>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th style="width:100px;">Imagem</th>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th style="text-align:center;">@Html.DisplayNameFor(model => model.QtdEstoque)</th>
            <th style="text-align:center;">@Html.DisplayNameFor(model => model.Ativo)</th>
            <th>@Html.DisplayNameFor(model => model.Categoria)</th>
            <th style="text-align:center;">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr data-categoria-id="@item.CategoriaId">
                <td>
                    <img src="@item.ImagemUrl" alt="@item.Nome"
                         style="width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid rgba(55,35,20,0.12);" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                <td style="text-align:center;">@Html.DisplayFor(modelItem => item.QtdEstoque)</td>
                <td style="text-align:center;">@Html.DisplayFor(modelItem => item.Ativo)</td>
                <td>@Html.DisplayFor(modelItem => item.Categoria!.Nome)</td>
                <td style="text-align:center;">
                    <a asp-action="Edit" asp-route-id="@item.ProdutoId">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.ProdutoId">Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@item.ProdutoId">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="~/js/admin-category-filter.js"></script>
}
