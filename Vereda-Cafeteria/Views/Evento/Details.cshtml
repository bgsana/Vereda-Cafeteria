@model Vereda_Cafeteria.Models.Evento

@{
    ViewData["Title"] = "Detalhes do Evento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Detalhes do Evento</h1>

<div>
    <dl class="row">
        <dd class="col-sm-10">
            <img src="@Model.ImagemUrl" alt="@Model.Titulo"
                 style="width:150px;height:150px;object-fit:cover;border-radius:6px;border:1px solid rgba(55,35,20,0.12);" />
        </dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Titulo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Titulo)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Descricao)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Descricao)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CorFundo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.CorFundo)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.EventoId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>
