@model IEnumerable<Vereda_Cafeteria.Models.Evento>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Eventos</h1>

<p>
    <a asp-action="Create">Adicionar</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagemUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CorFundo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Titulo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Descricao)
                </td>
                <td>
                    <img src="@item.ImagemUrl"
                         style="width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid rgba(55,35,20,0.12);" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CorFundo)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EventoId">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.EventoId">Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@item.EventoId">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
