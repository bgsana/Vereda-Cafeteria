@model IEnumerable<Vereda_Cafeteria.Models.Evento>

@{
    ViewData["Title"] = "Eventos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Eventos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Adicionar</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th style="width:100px;">Imagem</th>
            <th>@Html.DisplayNameFor(model => model.Titulo)</th>
            <th>@Html.DisplayNameFor(model => model.Descricao)</th>
            <th>@Html.DisplayNameFor(model => model.CorFundo)</th>
            <th style="text-align:center;">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImagemUrl" alt="@item.Titulo"
                         style="width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid rgba(55,35,20,0.12);" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                <td>@Html.DisplayFor(modelItem => item.CorFundo)</td>
                <td style="text-align:center;">
                    <a asp-action="Edit" asp-route-id="@item.EventoId">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.EventoId">Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@item.EventoId">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
