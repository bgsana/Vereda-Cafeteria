@model Vereda_Cafeteria.Models.Evento

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Delete</h1>

<h3>Tem certeza que deseja excluir este produto</h3>
<div>
    <h4>Evento</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
        <dd class="col-sm-10">
            <img src="@Model.ImagemUrl"
                 style="width:150px;height:150px;object-fit:cover;border-radius:6px;border:1px solid rgba(55,35,20,0.12);" />
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CorFundo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CorFundo)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.EventoId" />

        <input type="submit" value="Excluir" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
