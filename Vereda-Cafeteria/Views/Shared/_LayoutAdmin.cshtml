<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Vereda Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon.ico">

    <link rel="stylesheet" href="~/css/admin-consolidated.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<body>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <img src="~/img/logo-admin.png" alt="Logo Vereda" />
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <span class="nav-section-title">Geral</span>
                <a href="/admin" class="nav-link @(controller == "Admin" && action == "Index" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>
                <a asp-controller="Pedidos" asp-action="Index"
                   class="nav-link @(controller == "Pedidos" ? "active" : "")">
                    <i class="bi bi-receipt"></i>
                    <span>Pedidos</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">Conteúdo Site</span>
                <a href="/Admin/NossoAmbiente/Index" class="nav-link @(controller == "NossoAmbiente" ? "active" : "")">
                    <i class="bi bi-images"></i>
                    <span>Nosso Ambiente</span>
                </a>
                <a href="/Admin/ProdutoMenu/Index" class="nav-link @(controller == "ProdutoMenu" ? "active" : "")">
                    <i class="bi bi-cup-hot"></i>
                    <span>Menu</span>
                </a>
                <a href="/Admin/ProdutoAtelie/Index" class="nav-link @(controller == "ProdutoAtelie" ? "active" : "")">
                    <i class="bi bi-bag-dash"></i>
                    <span>Ateliê Vereda</span>
                </a>
                <a href="/admin/evento/Index" class="nav-link @(controller == "Evento" ? "active" : "")">
                    <i class="bi bi-calendar-event"></i>
                    <span>Eventos</span>
                </a>

            </div>

            <div class="nav-section">
                <span class="nav-section-title">Financeiro</span>
                <a href="/admin/financeiro" class="nav-link @(controller == "Financeiro" ? "active" : "")">
                    <i class="bi bi-cash-stack"></i>
                    <span>Financeiro</span>
                </a>
                <a href="/admin/relatorios" class="nav-link @(controller == "Relatorios" ? "active" : "")">
                    <i class="bi bi-graph-up"></i>
                    <span>Relatórios</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">Sistema</span>
                <form asp-controller="Conta" asp-action="Logout" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link logout-link"
                            style="background:none;border:none;width:100%;text-align:left;cursor:pointer;">
                        <i class="bi bi-box-arrow-left"></i>
                        <span>Sair</span>
                    </button>
                </form>
            </div>
        </nav>

        <div class="sidebar-footer">

            <div class="topbar-right">
                <button class="profile-btn" type="button">
                    <div class="profile-avatar"><span>VR</span></div>
                    <div class="profile-info">
                        <span class="profile-name">Vereda</span>
                        <span class="profile-role">Admin</span>
                    </div>
                </button>
            </div>
        </div>
    </aside>

    <main class="main-wrapper">
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- <script src="~/js/admin.js" asp-append-version="true"></script> -->

    @RenderSection("Scripts", required: false)
</body>

</html>