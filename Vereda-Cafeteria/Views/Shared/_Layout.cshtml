<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vereda</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vereda_Cafeteria.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" type="image/png" sizes="16x16"  href="~/img/favicon.ico">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="theme-color" content="#ffffff">
</head>

<body>

    <header class="site-header">
        <div class="header-content">

            <ul class="header-menu left">
                <li><a asp-controller="Home" asp-action="Index">Início</a></li>
                <li><a asp-controller="Home" asp-action="SobreNos">Sobre Nós</a></li>
                <li><a asp-controller="Home" asp-action="NossoAmbiente">Nosso Ambiente</a></li>
            </ul>

            <div class="header-logo">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo.png" alt="Logo Vereda" />
                </a>
            </div>

            <ul class="header-menu right">
                <li><a asp-controller="Home" asp-action="Menu">Menu</a></li>
                <li><a asp-controller="Home" asp-action="Atelie">Vereda Ateliê</a></li>
                <li><a asp-controller="Home" asp-action="Eventos">Eventos</a></li>
            </ul>

        </div>
    </header>
    <div class="container-fluid p-0">
        @RenderBody()
    </div>

    <footer class="footer">
        <div class="footer-container">

            <div class="footer-logo">
                <a asp-controller="Home" asp-action="Index">
                    <img height="180" src="~/img/logo.png" alt="Logo Vereda" />
                </a>
            </div>

            <div class="footer-column">
                <h3>Menu institucional</h3>
                <ul>
                    <li><a href="#">Home</a></li>
                    <li><a href="#">Sobre nós</a></li>
                    <li><a href="#">Nosso Ambiente</a></li>
                    <li><a href="#">Menu</a></li>
                    <li><a href="#">Loja Vereda</a></li>
                    <li><a href="#">Eventos</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Fale Conosco</h3>
                <p class="contatos-info"><i class="ti ti-mail"></i>vereda.barrabonita@gmail.com</p>
                <p class="contatos-info"><i class="ti ti-phone"></i>14 99885-9509</p>
                <p class="contatos-info contatos-info-loc"><i class="ti ti-map-pin"></i>R. Primeiro de Março, 234 - Centro,<br>Barra Bonita - SP, 17340-035</p>

                    <div class="social-icons">
                        <a href="https://www.instagram.com/veredacafeteria/" target="_blank"><i class="fa-brands fa-instagram"></i></a>
                        <a href="https://www.facebook.com/veredacafeteria/?locale=pt_BR" target="_blank"><i class="fa-brands fa-facebook icon-facebook"></i></a>
                        <a href="https://wa.me/5514998859509" target="_blank"><i class="fa-brands fa-whatsapp"></i></a>
                    </div>
                </div>

                <div class="footer-column">
                    <h3>Horário de Atendimento</h3>
                    <p class="highlight">Segunda à Sábado</p>
                    <p>9h às 18h</p>
                    <p class="highlight">Domingo</p>
                    <p>9h às 12h</p>
                </div>

            </div>

            <div class="linha-divisor"></div>

            <div class="footer-bottom">
                <a asp-controller="Home" asp-action="PoliticaDePrivacidade">Política de Privacidade</a>
                <a asp-controller="Home" asp-action="TermosDeUso">Termos de Uso</a>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)

    </body>

</html>