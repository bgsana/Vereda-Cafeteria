@model LoginVM
@{
    Layout = null; // Não usa o layout compartilhado
}


<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/login.css">
    <title>Vereda Cafeteria - Login</title>
</head>
<body>

    <div class="container">
        <div class="coluna-esquerda">
            <h1 class="titulo">Bem-vindo à Área Administrativa</h2>
            <p class="subtitulo">Faça o login e tenha acesso</p>

            <form class="grupo-inputs" id="loginForm" asp-action="Login">

                <input asp-for="ReturnUrl">

                <div class="grupo-input">
                    <label class="input-label" asp-for="Email"></label>
                    <input class="input-input" asp-for="Email">
                    <span class="mensagem-erro" asp-validationfor="Email"></span>
                </div>
                
                <div class="form-group">
                    <label class="input-label" asp-for="Senha"></label>
                    <input class="input-input" asp-for="Senha">
                    <span class="mensagem-erro" asp-validationfor="Senha"></span>
                </div>

                <label class="manter-conectado">
                    <input type="checkbox" asp-for="ManterConectado">
                    <label class="form-label" asp-for="ManterConectado"></label>
                </label>

                <button type="submit" class="btn-entrar" disabled="@(TempData["Success"] != null)">Entrar</button>

            </form>
        </div>

        <div class="coluna-direita">
            <img src="~/img/imglogin.png" alt="imagem-teste">
        </div>
    </div>

</body>
</html>