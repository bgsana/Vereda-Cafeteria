@{
    ViewData["Title"] = "Início";
}

<div id="carouselExampleIndicators" class="carousel slide">
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
  </div>
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img src="~/img/teste1.png" class="d-block w-100" alt="...">
    </div>
    <div class="carousel-item">
      <img src="~/img/teste2.png" class="d-block w-100" alt="...">
    </div>
    <div class="carousel-item">
      <img src="~/img/teste3.png" class="d-block w-100" alt="...">
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>

<!-- CARD 1 - SOBRE NÓS -->
<section class="home-section sobreNos">
    <div class="container-fluid">
    <div class="row align-items-center g-0">

    <div class="col-md-5 text-content">
        <div class="text-box">
            <h2>Sobre Nós</h2>
            <p>
                Lorem ipsum dolor sit amet,
                consectetur adipiscing elit.
                In sit amet sollicitudin turpis.
            </p>

            <a asp-controller="Sobre"
               asp-action="Index"
               class="btn-vereda">
               Conheça nossa história
            </a>
        </div>
    </div>

    <div class="col-md-7 fotos-container">
        <div class="fotos-grid">
            <img src="~/img/Inicio/donos.jpg" class="foto-grande">
            <img src="~/img/Inicio/sobre2.JPG">
            <img src="~/img/Inicio/sobre3.jpeg">
        </div>
    </div>
</div>
</div>
</section>

<section class="home-section ambiente">
    <div class="container">
        <div class="row align-items-center flex-md-row-reverse">

            <div class="col-md-6">
                <h2>Nosso Ambiente</h2>
                <p>
                    Um espaço pensado para acolher, inspirar e proporcionar
                    momentos especiais.
                </p>
                <a asp-controller="Galeria"
                   asp-action="Index"
                   class="btn-vereda">
                   Galeria de fotos
                </a>
            </div>

            <div class="col-md-6 fotos-grid">
                <img src="~/img/amb1.jpg" />
                <img src="~/img/amb2.jpg" />
                <img src="~/img/amb3.jpg" />
            </div>

        </div>
    </div>
</section>

<section class="home-section cardapio">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-6">
                <h2>Cardápio</h2>
                <p>
                    Descubra sabores preparados com carinho.
                </p>
                <a asp-controller="Cardapio"
                   asp-action="Index"
                   class="btn-vereda">
                   Ver cardápio
                </a>
            </div>

            <div class="col-md-6">
                <video controls width="100%">
                    <source src="~/videos/cardapio.mp4" type="video/mp4">
                </video>
            </div>

        </div>
    </div>
</section>

</div>
