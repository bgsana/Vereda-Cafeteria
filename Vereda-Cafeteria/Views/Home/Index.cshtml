@model List<Produto>

@{
    ViewData["Title"] = "Início";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<section class="banner-section">
    <div class="banner-carousel-wrapper">

        <button class="banner-btn-prev" id="bannerBtnPrev" aria-label="Anterior">&#8249;</button>

        <div class="banner-carousel-viewport">
            <div class="banner-carousel-clip">
                <div class="banner-carousel-track" id="bannerTrack">
                    @if (ViewBag.Banners != null && ((List<Banner>)ViewBag.Banners).Any())
                    {
                        @foreach (var banner in (List<Banner>)ViewBag.Banners)
                        {
                            <div class="banner-item">
                                <img src="@banner.ImagemUrl" alt="@banner.Titulo" loading="lazy">
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <button class="banner-btn-next" id="bannerBtnNext" aria-label="Próximo">&#8250;</button>

    </div>
</section>

<div class="divider"></div>

<!-- SOBRE NÓS -->
<section class="section about" id="sobre">
    <div class="panel panel-brown panel-text">
        <h2>Sobre Nós</h2>
        <p>
            Uma pequena ideia que ganhou vida,<br />
            movida pela paixão e pelo desejo de acolher.
        </p>

        <a asp-controller="Home" asp-action="SobreNos" class="btn-sobre">
            Conheça nossa história
        </a>
    </div>

    <div class="photo-layout photo-layout-about">
        <div class="photo photo-main">
            <img src="~/img/Inicio/donos.jpg" />
        </div>

        <div class="photo-stack">
            <div class="photo">
                <img src="~/img/Inicio/sobre2.JPG" />
            </div>
            <div class="photo">
                <img src="~/img/Inicio/sobre3.png" />
            </div>
        </div>
    </div>
</section>

<!-- AMBIENTE -->
<section class="section environment" id="ambiente">
    <div class="photo-layout photo-layout-environment">
        <div class="photo-stack left-stack">
            <div class="photo">
                <img src="~/img/Inicio/amb2.png" />
            </div>
            <div class="photo">
                <img src="~/img/Inicio/amb3.png" />
            </div>
        </div>

        <div class="photo photo-main vertical-main">
            <img src="~/img/Inicio/amb1.png" />
        </div>
    </div>

    <div class="panel panel-red panel-text">
        <h2>Nosso Ambiente</h2>
        <p>
            Um espaço pensado para acolher,<br />
            inspirar e proporcionar momentos especiais.
        </p>

        <a asp-controller="Home" asp-action="NossoAmbiente" class="btn-ambiente">
            Galeria de fotos
        </a>
    </div>
</section>

<!-- CARDÁPIO -->
<section class="section menu-section" id="cardapio">
    <div class="panel panel-teal panel-text">
        <h2>Menu</h2>
        <p>
            Receitas artesanais feitas na hora,<br />
            com sabor de casa, carinho e um toque especial.
        </p>

        <a asp-controller="Menu" asp-action="" class="btn-cardapio">
            Descubra nossas delícias
        </a>
    </div>

    <div class="photo single-photo">
        <video autoplay muted loop playsinline width="100%">
            <source src="~/img/Inicio/video.mov" type="video/mp4">
        </video>
    </div>
</section>


<!-- VEREDA ATELIÊ -->
<section class="store" id="atelie">
    <h2>Vereda Ateliê</h2>
    <p class="atelie-subtitulo">Produtos artesanais criados com afeto para levar um pedaço da Vereda para casa.</p>

    <div class="atelie-carousel-wrapper">

        <button class="atelie-btn-prev" id="atelieBtnPrev" aria-label="Anterior">&#8249;</button>

        <div class="atelie-carousel-viewport">
            <div class="atelie-carousel-track" id="atelieTrack">
                @if (Model != null && Model.Any())
                {
                    @foreach (var produto in Model)
                    {
                        <a class="atelie-card"
                           href="/Atelie#categoria-@produto.CategoriaId"
                           data-id="@produto.ProdutoId"
                           data-nome="@produto.Nome"
                           data-descricao="@produto.Descricao"
                           data-preco="@produto.Preco.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                           data-imagem="@produto.ImagemUrl"
                           data-cor="@produto.Categoria?.CorHex">
                            <img src="@produto.ImagemUrl" alt="@produto.Nome" loading="lazy">
                        </a>
                    }
                }
            </div>
        </div>

        <button class="atelie-btn-next" id="atelieBtnNext" aria-label="Próximo">&#8250;</button>

    </div>

    <a asp-controller="Home" asp-action="Atelie" class="atelie-home-link">
        Conheça o Vereda Ateliê
    </a>
</section>


@section Scripts {
    <script>
    (function () {
        const track = document.getElementById('bannerTrack');
        const btnPrev = document.getElementById('bannerBtnPrev');
        const btnNext = document.getElementById('bannerBtnNext');
        if (!track || !track.children.length) return;

        const originals = Array.from(track.children);
        const N = originals.length;
        const COPIES = 5;

        track.innerHTML = '';
        for (let c = 0; c < COPIES; c++) {
            originals.forEach(orig => {
                const clone = orig.cloneNode(true);
                track.appendChild(clone);
            });
        }

        let pos = N;
        let busy = false;
        let autoTimer = null;
        const AUTO_MS = 7000;
        const ANIM_MS = 600;

        const GAP = 48;
        function getStep() {
            return track.children[0].getBoundingClientRect().width + GAP;
        }

        function getOffset(index) {
            return index * getStep();
        }

        function jumpTo(index) {
            track.style.transition = 'none';
            track.style.transform  = `translateX(-${getOffset(index)}px)`;
            pos = index;
        }

        function slideTo(index, cb) {
            track.style.transition = `transform ${ANIM_MS}ms ease`;
            track.style.transform  = `translateX(-${getOffset(index)}px)`;
            pos = index;

            setTimeout(() => {
                track.style.transition = 'none';
                const normalised = ((pos % N) + N) % N;
                const target     = N + normalised;
                if (pos !== target) {
                    track.style.transform = `translateX(-${getOffset(target)}px)`;
                    pos = target;
                }
                busy = false;
                if (cb) cb();
            }, ANIM_MS + 20);
        }

        function goNext() {
            if (busy) return;
            busy = true;
            stopAuto();
            slideTo(pos + 1, startAuto);
        }

        function goPrev() {
            if (busy) return;
            busy = true;
            stopAuto();
            slideTo(pos - 1, startAuto);
        }

        function autoStep() {
            if (busy) return;
            busy = true;
            slideTo(pos + 1, null);
        }

        function startAuto() {
            stopAuto();
            autoTimer = setInterval(autoStep, AUTO_MS);
        }

        function stopAuto() {
            if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
        }

        window.addEventListener('resize', () => {
            jumpTo(pos);
        });

        jumpTo(pos);
        setTimeout(startAuto, 50);

        btnNext.addEventListener('click', goNext);
        btnPrev.addEventListener('click', goPrev);
    })();

    (function () {
        const track    = document.getElementById('atelieTrack');
        const btnPrev  = document.getElementById('atelieBtnPrev');
        const btnNext  = document.getElementById('atelieBtnNext');
        if (!track || !track.children.length) return;

        const CARD_WIDTH  = 300;
        const GAP         = 48;
        const STEP        = CARD_WIDTH + GAP;
        const AUTO_MS     = 3500;
        const ANIM_MS     = 420;
        
        const originals = Array.from(track.children);
        const N = originals.length;
        const COPIES = 5;
        
        track.innerHTML = '';
        for (let c = 0; c < COPIES; c++) {
            originals.forEach(orig => {
                const clone = orig.cloneNode(true);
                track.appendChild(clone);
            });
        }

        let pos = N;
        let busy = false;
        let autoTimer = null;

        function getOffset(index) {
            return index * STEP;
        }

        function jumpTo(index) {
            track.style.transition = 'none';
            track.style.transform  = `translateX(-${getOffset(index)}px)`;
            pos = index;
        }

        function slideTo(index, cb) {
            track.style.transition = `transform ${ANIM_MS}ms ease`;
            track.style.transform  = `translateX(-${getOffset(index)}px)`;
            pos = index;

            setTimeout(() => {
                track.style.transition = 'none';
                const normalised = ((pos % N) + N) % N;
                const target     = N + normalised;
                if (pos !== target) {
                    track.style.transform = `translateX(-${getOffset(target)}px)`;
                    pos = target;
                }
                busy = false;
                if (cb) cb();
            }, ANIM_MS + 20);
        }

        function goNext() {
            if (busy) return;
            busy = true;
            stopAuto();
            slideTo(pos + 1, startAuto);
        }

        function goPrev() {
            if (busy) return;
            busy = true;
            stopAuto();
            slideTo(pos - 1, startAuto);
        }

        function autoStep() {
            if (busy) return;
            busy = true;
            slideTo(pos + 1, null);
        }

        function startAuto() {
            stopAuto();
            autoTimer = setInterval(autoStep, AUTO_MS);
        }

        function stopAuto() {
            if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
        }

        jumpTo(pos);
        setTimeout(startAuto, 50);

        btnNext.addEventListener('click', goNext);
        btnPrev.addEventListener('click', goPrev);
    })();

    </script>
}
