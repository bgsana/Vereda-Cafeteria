@model List<Produto>

@{
    ViewData["Title"] = "Início";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<div id="carouselExampleIndicators" class="carousel slide">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/img/teste1.png" class="d-block w-100">
        </div>
        <div class="carousel-item">
            <img src="~/img/teste2.png" class="d-block w-100">
        </div>
        <div class="carousel-item">
            <img src="~/img/teste3.png" class="d-block w-100">
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<div class="divider"></div>

<!-- SOBRE NÓS -->
<section class="section about" id="sobre">
    <div class="panel panel-brown panel-text">
        <h2>Sobre Nós</h2>
        <p>
            Lorem ipsum dolor sit amet,<br />
            consectetur adipiscing elit.<br />
            In sit amet sollicitudin turpis.
        </p>

        <a asp-controller="SobreNos" asp-action="Index" class="btn-sobre">
            Conheça nossa história
        </a>
    </div>

    <div class="photo-layout photo-layout-about">
        <div class="photo photo-main">
            <img src="~/img/Inicio/donos.jpg" />
        </div>

        <div class="photo-stack">
            <div class="photo">
                <img src="~/img/Inicio/sobre2.JPG" />
            </div>
            <div class="photo">
                <img src="~/img/Inicio/sobre3.png" />
            </div>
        </div>
    </div>
</section>

<div class="divider"></div>

<!-- AMBIENTE -->
<section class="section environment" id="ambiente">
    <div class="photo-layout photo-layout-environment">
        <div class="photo-stack left-stack">
            <div class="photo">
                <img src="~/img/Inicio/amb2.png" />
            </div>
            <div class="photo">
                <img src="~/img/Inicio/amb3.png" />
            </div>
        </div>

        <div class="photo photo-main vertical-main">
            <img src="~/img/Inicio/amb1.png" />
        </div>
    </div>

    <div class="panel panel-red panel-text">
        <h2>Nosso Ambiente</h2>
        <p>
            Um espaço pensado para acolher,<br />
            inspirar e proporcionar momentos especiais.
        </p>

        <a asp-controller="NossoAmbiente" asp-action="Index" class="btn-ambiente">
            Galeria de fotos
        </a>
    </div>
</section>

<div class="divider"></div>

<!-- CARDÁPIO -->
<section class="section menu-section" id="cardapio">
    <div class="panel panel-teal panel-text">
        <h2>Cardápio</h2>
        <p>
            Descubra sabores preparados com carinho.
        </p>

        <a asp-controller="Menu" asp-action="" class="btn-cardapio">
            Ver cardápio
        </a>
    </div>

    <div class="photo single-photo">
        <video controls width="100%">
            <source src="~/img/Inicio/video.mov" type="video/mp4">
        </video>
    </div>
</section>

<div class="divider"></div>

<!-- VEREDA ATELIÊ -->
<section class="store" id="atelie">
    <h2>Vereda Ateliê</h2>

    <div class="atelie-carousel-wrapper">

        <button class="atelie-btn-prev" id="atelieBtnPrev" aria-label="Anterior">&#8249;</button>

        <div class="atelie-carousel-viewport">
            <div class="atelie-carousel-track" id="atelieTrack">
                @if (Model != null && Model.Any())
                {
                    @foreach (var produto in Model)
                    {
                        <a class="atelie-card"
                           href="/Atelie#categoria-@produto.CategoriaId"
                           data-id="@produto.ProdutoId"
                           data-nome="@produto.Nome"
                           data-descricao="@produto.Descricao"
                           data-preco="@produto.Preco.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                           data-imagem="@produto.ImagemUrl"
                           data-cor="@produto.Categoria?.CorHex">
                            <img src="@produto.ImagemUrl" alt="@produto.Nome" loading="lazy">
                        </a>
                    }
                }
            </div>
        </div>

        <button class="atelie-btn-next" id="atelieBtnNext" aria-label="Próximo">&#8250;</button>

    </div>

    <a asp-controller="Home" asp-action="Atelie" class="atelie-home-link">
        Ver Vereda Ateliê
    </a>
</section>

<div class="divider"></div>

@section Scripts {
    <script>
    // ===== CARROSSEL DO ATELIÊ =====
    (function () {
        const track    = document.getElementById('atelieTrack');
        const btnPrev  = document.getElementById('atelieBtnPrev');
        const btnNext  = document.getElementById('atelieBtnNext');
        if (!track || !track.children.length) return;

        const CARD_WIDTH  = 300;
        const GAP         = 48;
        const STEP        = CARD_WIDTH + GAP;
        const AUTO_MS     = 3500;   // intervalo do avanço automático
        const ANIM_MS     = 420;    // duração da transição CSS

        // ---- Clonagem: repete o conjunto 5× para nunca acabar ----
        const originals = Array.from(track.children);
        const N = originals.length;
        const COPIES = 5;   // quantas repetições ao total (incluindo o original)

        // Apaga filhos originais, reconstrói com COPIES repetições
        track.innerHTML = '';
        for (let c = 0; c < COPIES; c++) {
            originals.forEach(orig => {
                const clone = orig.cloneNode(true);
                track.appendChild(clone);
            });
        }

        // Cards são <a> com href — a navegação ocorre nativamente via cloneNode(true)

        // Posição inicial: começa no 2º bloco (índice N) para ter margem em ambos os lados
        let pos = N;          // índice do card atual (0-based dentro dos COPIES*N cards)
        let busy = false;
        let autoTimer = null;

        function getOffset(index) {
            return index * STEP;
        }

        // Aplica posição sem animação
        function jumpTo(index) {
            track.style.transition = 'none';
            track.style.transform  = `translateX(-${getOffset(index)}px)`;
            pos = index;
        }

        // Desliza animado para index
        function slideTo(index, cb) {
            track.style.transition = `transform ${ANIM_MS}ms ease`;
            track.style.transform  = `translateX(-${getOffset(index)}px)`;
            pos = index;

            setTimeout(() => {
                track.style.transition = 'none';
                // Reposiciona no bloco equivalente do meio sem que o usuário perceba
                const normalised = ((pos % N) + N) % N;      // posição dentro de um bloco
                const target     = N + normalised;            // ancora no 2º bloco
                if (pos !== target) {
                    track.style.transform = `translateX(-${getOffset(target)}px)`;
                    pos = target;
                }
                busy = false;
                if (cb) cb();
            }, ANIM_MS + 20);   // +20ms de folga
        }

        function goNext() {
            if (busy) return;
            busy = true;
            stopAuto();
            slideTo(pos + 1, startAuto);
        }

        function goPrev() {
            if (busy) return;
            busy = true;
            stopAuto();
            slideTo(pos - 1, startAuto);
        }

        function autoStep() {
            if (busy) return;
            busy = true;
            slideTo(pos + 1, null);
        }

        function startAuto() {
            stopAuto();
            autoTimer = setInterval(autoStep, AUTO_MS);
        }

        function stopAuto() {
            if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
        }

        // Posição inicial sem animação
        jumpTo(pos);
        // Pequeno delay para garantir que o DOM processou o jumpTo antes de ligar o auto
        setTimeout(startAuto, 50);

        btnNext.addEventListener('click', goNext);
        btnPrev.addEventListener('click', goPrev);
    })();

    </script>
}
