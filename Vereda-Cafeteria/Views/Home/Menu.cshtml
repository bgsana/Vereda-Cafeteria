@model List<Categoria>

@{
    ViewData[index: "Title"] = "Menu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/menu.css" />
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<h1>Cardápio</h1>

<nav class="barra-categorias">
    @foreach (Categoria categoria in Model)
    {
        <a href="#categoria-@categoria.CategoriaId">@categoria.Nome</a>
    }
    <a class="carrinho" asp-controller="Home" asp-action="Carrinho">
        <i class="ti ti-shopping-cart-filled carrinho-icon"></i>
        <span class="carrinho-badge">0</span>
    </a>
</nav>

@foreach (Categoria categoria in Model)
{
    <section class="secao" id="categoria-@categoria.CategoriaId">
        <h3>@categoria.Nome</h3>

        <div class="secao-cards">
            @foreach (Produto produto in categoria.Produtos!)
            {
                <div class="card">
                    <img src="@produto.ImagemUrl" alt="@produto.Nome">
                    <div class="card-footer">
                        <h5>@produto.Nome</h5>
                    </div>
                </div>
            }
        </div>
    </section>
}
