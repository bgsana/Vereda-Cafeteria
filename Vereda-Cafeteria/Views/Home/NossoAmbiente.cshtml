@model IEnumerable<Vereda_Cafeteria.Models.AmbienteImagem>

@{
    ViewData[index: "Title"] = "Nosso Ambiente";
}

@section Styles {
    <link rel="stylesheet" href="~/css/nossoambiente.css" />
}

<section class="nosso-ambiente">
    <div class="nosso-ambiente-header">
        <h2>Nosso Ambiente</h2>
        <h5>Um oásis no coração de Barra Bonita</h5>
        <p>
            Aqui o tempo desacelera. Entre plantas, luz natural e um ambiente cuidado nos mínimos detalhes,
            a Vereda oferece um refúgio verdadeiro no centro de Barra Bonita, para reuniões, pausas ou simplesmente
            experimentar nossos sabores.
        </p>
    </div>

    <div class="nosso-ambiente-grid">
        @foreach (AmbienteImagem imagem in Model)
        {
            <div class="nosso-ambiente-item">
                <img src="@Url.Content(imagem.CaminhoImagem)" class="ambiente-img" />
            </div>
        }
    </div>

    <div class="ambiente-modal-overlay" id="ambienteModalOverlay">
        <img src="" alt="" class="ambiente-modal-img" id="ambienteModalImg" />
    </div>

    @section Scripts {
        <script src="~/js/nossoambiente.js"></script>
    }
</section>