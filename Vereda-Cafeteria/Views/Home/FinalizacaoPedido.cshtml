@{
    ViewData["Title"] = "Finalização do Pedido";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finalizacaopedido.css" />
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<!-- TELA 1: Formulário -->
<section class="carrinho-container" id="tela-formulario">

    <h1 class="titulo">Finalização do Pedido</h1>

    <div class="layout-principal">

        <div class="coluna-itens">

            <div class="form-grupo">
                <div class="form-campo campo-nome">
                    <label>Nome Completo</label>
                    <input type="text" id="campo-nome" placeholder="Digite seu nome completo">
                </div>
                <div class="form-campo">
                    <label>Telefone</label>
                    <input type="text" id="campo-telefone" placeholder="(14) 99999-9999">
                </div>
            </div>

            <div class="grupo-cards">

                <div class="card-secao">
                    <h2 class="secao-titulo">Forma de Pagamento</h2>
                    <div class="caixa-pagamento">
                        <label class="opcao">
                            <input type="radio" name="pagamento" value="Pix" checked>
                            <span><i class="fa-brands fa-pix icon-pag icon-pix"></i>Pix</span>
                        </label>
                        <label class="opcao">
                            <input type="radio" name="pagamento" value="Dinheiro">
                            <span><i class="ti ti-coin-filled icon-pag icon-dinheiro"></i>Dinheiro</span>
                        </label>
                        <label class="opcao">
                            <input type="radio" name="pagamento" value="Cartão">
                            <span><i class="fa-solid fa-credit-card icon-pag"></i>Cartão</span>
                        </label>
                    </div>
                </div>

                <div class="card-secao">
                    <h2 class="secao-titulo">Forma de Recebimento</h2>
                    <div class="caixa-recebimento">
                        <div class="entrega-opcoes">
                            <button class="btn-opcao ativo" id="btn-retirada" onclick="selecionarOpcao('retirada')">
                                <i class="ti ti-building-store"></i>
                                <span>Retirada</span>
                            </button>
                            <button class="btn-opcao" id="btn-entrega" onclick="selecionarOpcao('entrega')">
                                <i class="ti ti-bike"></i>
                                <span>Entrega</span>
                            </button>
                        </div>

                        <div class="info-retirada visivel" id="info-retirada">
                            <i class="ti ti-map-pin"></i>
                            <div>
                                <span class="retirada-label">Retire no local</span>
                                <span class="retirada-endereco">R. Primeiro de Março, 234 — Centro<br>Barra Bonita - SP, 17340-035</span>
                            </div>
                        </div>

                        <div class="campos-endereco" id="campos-endereco">
                            <select class="campo-endereco campo-cidade" id="campo-cidade" onchange="this.classList.add('selecionado')">
                                <option value="" disabled selected>Cidade</option>
                                <option value="Barra Bonita">Barra Bonita</option>
                                <option value="Igaraçu do Tietê">Igaraçu do Tietê</option>
                            </select>
                            <input type="text" id="campo-rua" class="campo-endereco" placeholder="Rua / Avenida">
                            <div class="linha-dois-campos">
                                <input type="text" id="campo-numero" class="campo-endereco campo-numero" placeholder="Nº" maxlength="6" inputmode="numeric" pattern="[0-9]*" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                <input type="text" id="campo-bairro" class="campo-endereco campo-bairro" placeholder="Bairro">
                            </div>
                            <input type="text" id="campo-complemento" class="campo-endereco" placeholder="Complemento (opcional)">
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="caixa-resumo">
            <h2 class="resumo-titulo">Resumo do pedido</h2>
            <div class="resumo-linha" id="resumo-linhas"></div>
            <div class="resumo-linha" id="linha-taxa" style="display: none;">
                <span style="font-weight: 600; color: var(--vermelho)">+ Taxa de entrega</span>
                <span>R$ 8,00</span>
            </div>
            <div class="resumo-divisor"></div>
            <div class="resumo-total">
                <span>Total</span>
                <span id="valor-total">R$ 0,00</span>
            </div>
            <button class="btn-finalizar" onclick="confirmarPedido()">Confirmar pedido</button>
        </div>

    </div>

</section>

<!-- TELA 2: Pós-confirmação -->
<section class="carrinho-container" id="tela-confirmacao" style="display:none">

    <h1 class="titulo">Pedido confirmado!</h1>

    <div class="confirmacao-layout">

        <!-- Card: deu certo -->
        <div class="confirmacao-card card-sucesso">
            <div class="confirmacao-cabecalho">
                <div class="confirmacao-icone">
                    <i class="ti ti-circle-check"></i>
                </div>
                <h2>Tudo certo!</h2>
            </div>
            <p>Obrigado pelo pedido! Assim que a mensagem chegar pelo WhatsApp, nossa equipe confirma os detalhes e já inicia o preparo com carinho.<br>Fique de olho nas mensagens para acompanhar tudo por lá.</p>
            <div class="confirmacao-botoes-grupo">
                <a href="/" class="btn-confirmacao btn-voltar-home">
                    <i class="ti ti-home"></i>
                    Voltar ao Início
                </a>
                <a href="/Menu" class="btn-confirmacao btn-voltar-cardapio">
                    <i class="ti ti-notebook"></i>
                    Voltar ao Menu
                </a>
                <a href="/Atelie" class="btn-confirmacao btn-voltar-atelie">
                    <i class="ti ti-building-store"></i>
                    Voltar ao Vereda Ateliê
                </a>
            </div>
        </div>

        <!-- Card: fallback -->
        <div class="confirmacao-card card-fallback">
            <div class="confirmacao-cabecalho">
                <div class="confirmacao-icone icone-aviso">
                    <i class="ti ti-brand-whatsapp"></i>
                </div>
                <h2>Não abriu o WhatsApp?</h2>
            </div>
            <p>Sem problema! Copie a mensagem abaixo e envie manualmente para o nosso número: <strong>14 99885-9509</strong>.</p>
            <div class="confirmacao-corpo-fallback">
                <div class="mensagem-copiavel" id="mensagem-copiavel"></div>
                <button class="btn-confirmacao btn-copiar" onclick="copiarMensagem()">
                    <i class="ti ti-copy"></i>
                    Copiar mensagem
                </button>
            </div>
        </div>

    </div>

</section>

@section Scripts {
    @Html.AntiForgeryToken()
    <script src="~/js/finalizacaopedido.js"></script>
}
