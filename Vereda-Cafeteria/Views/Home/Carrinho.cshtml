@{
    ViewData["Title"] = "Carrinho";
}

@section Styles {
    <link rel="stylesheet" href="~/css/carrinho.css" />
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<section class="carrinho-container">

    <h1 class="titulo">Carrinho</h1>

    <div class="layout-principal">

        <!-- Coluna de itens -->
        <div class="coluna-itens" id="coluna-itens">
            <!-- Preenchido pelo carrinho.js -->
        </div>

        <!-- Resumo do pedido -->
        <div class="caixa-resumo">
            <h2 class="resumo-titulo">Resumo do pedido</h2>

            <div class="resumo-linha" id="resumo-linhas">
                <!-- Preenchido pelo carrinho.js -->
            </div>

            <div class="resumo-divisor"></div>

            <div class="resumo-total">
                <span>Total</span>
                <span id="resumo-total-valor">R$ 0,00</span>
            </div>

            <button class="btn-finalizar" id="btn-finalizar">Finalizar pedido</button>
        </div>

    </div>

</section>

<!-- Modal de detalhe (somente leitura) -->
<div class="modal-overlay" id="modal-overlay" onclick="fecharModalOverlay(event)">
    <div class="modal-produto">
        <div class="modal-coluna-esquerda">
            <img id="modal-imagem" src="" alt="Imagem do produto">
        </div>
        <div class="modal-coluna-direita">
            <h2 id="modal-nome"></h2>
            <p id="modal-descricao"></p>
            <h3 id="modal-preco"></h3>
        </div>
    </div>
</div>

<!-- Modal de edição de escolha -->
<div class="modal-editar-overlay" id="modal-editar-overlay" onclick="fecharModalEditarOverlay(event)">
    <div class="modal-editar">
        <h2 id="modal-editar-nome"></h2>
        <p id="modal-editar-descricao"></p>
        <div id="modal-editar-opcoes"></div>
        <button class="modal-editar-confirmar" id="modal-editar-confirmar" onclick="confirmarEdicao()">
            Confirmar escolha
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/carrinho.js"></script>
}
