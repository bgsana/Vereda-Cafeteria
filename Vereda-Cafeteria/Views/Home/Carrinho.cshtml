@{
    ViewData["Title"] = "Carrinho";
}

@section Styles {
    <link rel="stylesheet" href="~/css/carrinho.css" />
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<section class="carrinho-container">

    <h1 class="titulo">Carrinho</h1>

    <div class="layout-principal">

        <div class="coluna-itens">

            <div class="item-carrinho">
                <div class="coluna-esquerda">
                    <div class="info-item">
                        <h2>Pão de Queijo</h2>
                        <p>Escolha: presunto e queijo</p>
                        <h3>R$5,00</h3>

                        <div class="acoes">
                            <div class="btn-quantidade">
                                <button class="btn-subtracao">-</button>
                                <span>1</span>
                                <button class="btn-adicao">+</button>
                            </div>

                            <button class="btn-editar">
                                <i class="ti ti-edit"></i>
                                <span class="texto-editar">Editar</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="coluna-direita">
                    <img class="imagem-item" src="~/img/pao-teste.jpg" alt="img teste">
                </div>
            </div>

            <div class="item-carrinho">
                <div class="coluna-esquerda">
                    <div class="info-item">
                        <h2>Pão de Queijo</h2>
                        <p>Escolha: presunto e queijo</p>
                        <h3>R$5,00</h3>

                        <div class="acoes">
                            <div class="btn-quantidade">
                                <button class="btn-subtracao">-</button>
                                <span>1</span>
                                <button class="btn-adicao">+</button>
                            </div>

                            <button class="btn-editar">
                                <i class="ti ti-edit"></i>
                                <span class="texto-editar">Editar</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="coluna-direita">
                    <img class="imagem-item" src="~/img/pao-teste.jpg" alt="img teste">
                </div>
            </div>

        </div>

        <div class="caixa-resumo">
            <h2 class="resumo-titulo">Resumo do pedido</h2>

            <!-- Seleção de entrega/retirada -->
            <div class="entrega-opcoes">
                <button class="btn-opcao ativo" id="btn-retirada" onclick="selecionarOpcao('retirada')">
                    <i class="ti ti-building-store"></i>
                    <span>Retirada</span>
                </button>
                <button class="btn-opcao" id="btn-entrega" onclick="selecionarOpcao('entrega')">
                    <i class="ti ti-bike"></i>
                    <span>Entrega</span>
                </button>
            </div>

            <!-- Campos de endereço (ocultos por padrão) -->
            <div class="campos-endereco" id="campos-endereco">
                <select class="campo-endereco campo-cidade">
                    <option value="" disabled selected>Cidade</option>
                    <option value="barra-bonita">Barra Bonita</option>
                    <option value="igaracu">Igaraçu do Tietê</option>
                </select>
                <input type="text" class="campo-endereco" placeholder="Rua / Avenida">
                <div class="linha-dois-campos">
                    <input type="text" class="campo-endereco campo-numero" placeholder="Nº" maxlength="4">
                    <input type="text" class="campo-endereco campo-bairro" placeholder="Bairro">
                </div>
                <input type="text" class="campo-endereco" placeholder="Complemento (opcional)">
            </div>

            <div class="resumo-linhas">
                <div class="resumo-linha">
                    <span>Subtotal</span>
                    <span>R$10,00</span>
                </div>
                <div class="resumo-linha" id="linha-taxa" style="display: none;">
                    <span>Taxa de entrega</span>
                    <span>R$8,00</span>
                </div>
            </div>

            <div class="resumo-divisor"></div>

            <div class="resumo-total">
                <span>Total</span>
                <span id="valor-total">R$10,00</span>
            </div>

            <button class="btn-finalizar">Finalizar pedido</button>
        </div>

    </div>

</section>

<script>
    const SUBTOTAL = 10;
    const TAXA_ENTREGA = 8;

    function selecionarOpcao(opcao) {
        const btnRetirada = document.getElementById('btn-retirada');
        const btnEntrega = document.getElementById('btn-entrega');
        const camposEndereco = document.getElementById('campos-endereco');
        const linhaTaxa = document.getElementById('linha-taxa');
        const valorTotal = document.getElementById('valor-total');

        if (opcao === 'retirada') {
            btnRetirada.classList.add('ativo');
            btnEntrega.classList.remove('ativo');
            camposEndereco.classList.remove('visivel');
            linhaTaxa.style.display = 'none';
            valorTotal.textContent = `R$${SUBTOTAL.toFixed(2).replace('.', ',')}`;
        } else {
            btnEntrega.classList.add('ativo');
            btnRetirada.classList.remove('ativo');
            camposEndereco.classList.add('visivel');
            linhaTaxa.style.display = 'flex';
            const total = SUBTOTAL + TAXA_ENTREGA;
            valorTotal.textContent = `R$${total.toFixed(2).replace('.', ',')}`;
        }
    }
</script>